# ========================================
# AgriCore Backend — Environment Variables
# Copy this to .env and fill in real values
# ========================================

# Server
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT (Supabase uses its own JWT secret internally)
JWT_SECRET=your-jwt-secret-min-32-chars

# Weather API (Open-Meteo — free, no key needed)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_ARCHIVE_API_URL=https://archive-api.open-meteo.com/v1/archive

# Application
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
APP_URL=http://localhost:5500
STORAGE_BUCKET=agricore-files

# SMTP Email (TurboSMTP)
# Authentication: enabled
# Primary SSL port: 465
# Alternate SSL port: 25025
SMTP_HOST=pro.turbo-smtp.com
SMTP_PORT=465
SMTP_ALT_PORT=25025
SMTP_SECURE=true
SMTP_USER=your-consumer-key
SMTP_PASS=your-consumer-secret
SMTP_FROM_EMAIL=AgriCore Support <noreply@yourdomain.com>
